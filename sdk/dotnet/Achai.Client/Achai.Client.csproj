<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Achai.Client</PackageId>
    <Version>0.0.0</Version>
    <Authors>guavovic</Authors>
    <Description>Cliente .NET da achaí-API (CEP, logradouro, cidades, lote, consenso, coordenadas, distância e status), gerado a partir do OpenAPI.</Description>
    <PackageTags>cep;endereco;brasil;viacep;achai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://achai-api.vercel.app</PackageProjectUrl>
    <RepositoryUrl>https://github.com/guavovic/achai-api</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
