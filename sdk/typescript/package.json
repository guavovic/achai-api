{
  "name": "achai-api",
  "version": "0.0.0",
  "description": "Cliente TypeScript da achaí-API (CEP, logradouro, cidades, lote, consenso, coordenadas, distância e status), gerado a partir do OpenAPI.",
  "keywords": ["cep", "endereco", "brasil", "viacep", "achai"],
  "homepage": "https://achai-api.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guavovic/achai-api.git",
    "directory": "sdk/typescript"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "openapi-typescript ../openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3"
  }
}
