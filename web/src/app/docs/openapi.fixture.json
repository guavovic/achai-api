{
  "openapi": "3.1.1",
  "info": {
    "title": "achaí-API",
    "description": "Busca endereços brasileiros pelo CEP ou pelo logradouro, e lista as cidades de cada estado. Os dados vêm do ViaCEP, com a BrasilAPI como alternativa para CEP, e do IBGE. Erros seguem o ProblemDetails (RFC 9457), e cada IP pode fazer 60 requisições por minuto.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://achai-api.onrender.com/"
    }
  ],
  "paths": {
    "/buscar/{cep}": {
      "get": {
        "tags": [
          "Endereços"
        ],
        "summary": "Busca o endereço pelo CEP",
        "description": "Consulta o ViaCEP. Se ele estiver fora do ar ou lento, usa a BrasilAPI. CEP que não existe devolve 404.",
        "operationId": "GetAddressByZipCode",
        "parameters": [
          {
            "name": "cep",
            "in": "path",
            "description": "CEP com 8 dígitos, com ou sem traço. Exemplo: 01001000.",
            "required": true,
            "schema": {
              "pattern": "^\\d{5}-?\\d{3}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/buscar/{uf}/{cidade}/{logradouro}": {
      "get": {
        "tags": [
          "Endereços"
        ],
        "summary": "Busca endereços pelo logradouro",
        "description": "Consulta o ViaCEP, que devolve até 50 endereços. Sem resultado, devolve uma lista vazia.",
        "operationId": "SearchAddressesByStreet",
        "parameters": [
          {
            "name": "uf",
            "in": "path",
            "description": "Sigla do estado. Exemplo: SP.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cidade",
            "in": "path",
            "description": "Nome da cidade, com pelo menos 3 caracteres. Exemplo: São Paulo.",
            "required": true,
            "schema": {
              "minLength": 3,
              "type": "string"
            }
          },
          {
            "name": "logradouro",
            "in": "path",
            "description": "Parte do nome da rua, com pelo menos 3 caracteres. Exemplo: Paulista.",
            "required": true,
            "schema": {
              "minLength": 3,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AddressResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/buscar/cidades/{uf}": {
      "get": {
        "tags": [
          "Cidades"
        ],
        "summary": "Lista as cidades de um estado",
        "description": "Consulta o IBGE. Estado que não está entre as 27 siglas devolve 400.",
        "operationId": "GetCitiesByState",
        "parameters": [
          {
            "name": "uf",
            "in": "path",
            "description": "Sigla do estado. Exemplo: SC.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CityResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressResponse": {
        "required": [
          "cep",
          "logradouro",
          "complemento",
          "unidade",
          "bairro",
          "localidade",
          "uf",
          "estado",
          "regiao"
        ],
        "type": "object",
        "properties": {
          "cep": {
            "type": [
              "null",
              "string"
            ]
          },
          "logradouro": {
            "type": [
              "null",
              "string"
            ]
          },
          "complemento": {
            "type": [
              "null",
              "string"
            ]
          },
          "unidade": {
            "type": [
              "null",
              "string"
            ]
          },
          "bairro": {
            "type": [
              "null",
              "string"
            ]
          },
          "localidade": {
            "type": [
              "null",
              "string"
            ]
          },
          "uf": {
            "type": [
              "null",
              "string"
            ]
          },
          "estado": {
            "type": [
              "null",
              "string"
            ]
          },
          "regiao": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CityResponse": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Endereços"
    },
    {
      "name": "Cidades"
    }
  ]
}
